{
    "chmod": "0755",
    "directories": [
        "app",
        "bootstrap",
        "config"
    ],
    "files": [
        "composer.json"
    ],
    "exclude-composer-files": false,
    "dump-autoload": true,
    "exclude-dev-files": false,
    "check-requirements": true,
    "output": "quickpay.phar",
    "compression": "GZ",
    "compactors": [
        "KevinGH\\Box\\Compactor\\Php"
    ],
    "finder": [
        {
            "in": "vendor",
            "exclude": [
                "phpstan/phpstan",
                "larastan/larastan"
            ]
        }
    ]
}
